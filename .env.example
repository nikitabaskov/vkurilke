# BotFather -> /newbot
BOT_TOKEN=
# Public HTTPS origin, without a path or trailing slash.
BASE_URL=https://smoke.example.com
# DNS name for the optional Caddy HTTPS profile.
DOMAIN=smoke.example.com
# Host port; the Compose container always listens on 8080.
PORT=8080
# Local binary only; Compose uses its persistent /data volume.
DB_PATH=data/vkurilke.db
# Telegram user IDs, comma separated. Empty = nobody may create rooms.
# On first launch, send /id to the bot, fill this field, then recreate app.
ADMIN_IDS=
CHECK_INTERVAL_MINUTES=15
ANSWER_TIMEOUT_MINUTES=3
